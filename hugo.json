{
  "baseURL": "https://tsvsheet.github.io/docs.go-tq/",
  "title": "go-tq",
  "publishDir": "_site",
  "enableRobotsTXT": true,
  "markup": {
    "goldmark": {
      "renderHooks": {
        "link": {
          "useEmbedded": "fallback"
        },
        "image": {
          "useEmbedded": "fallback"
        }
      }
    }
  },
  "params": {
    "description": "go-tq — the tq TSV-query-language engine as an importable Go library.",
    "mainSite": "https://tsvsheet.com"
  },
  "disableKinds": [
    "taxonomy",
    "term"
  ],
  "module": {
    "imports": [
      {
        "path": "github.com/tsvsheet/theme.tsvsheet"
      }
    ]
  }
}
